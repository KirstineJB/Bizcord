{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/Profiles/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7206
        }
      ],
      "UpstreamPathTemplate": "/profiles/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "Key": "profiles-all",

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "profiles.read", "profiles.write" ]
      },

      "AddHeadersToRequest": {
        "X-UserId": "Claims[sub] > value",
        "X-UserRole": "Claims[role] > value"
      }
    },
    {
      //  Internal / east–west
      "DownstreamPathTemplate": "/api/v1/Profiles/internal/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7206
        }
      ],
      "UpstreamPathTemplate": "/internal/profiles/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "Key": "profiles-internal",

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "profiles.internal" ] 
      },

      "AddHeadersToRequest": {
        "X-ServiceId": "Claims[sub] > value",
        "X-UserRole": "Claims[role] > value"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7082"
  }
}